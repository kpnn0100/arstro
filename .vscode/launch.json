{
  // F5 (or the Run and Debug view) runs cosmo_v2. `preLaunchTask` rebuilds the
  // target FIRST, so you never launch a stale binary — this is what was missing
  // (with no build step wired, VSCode just re-ran the old executable).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "cosmo_v2",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/cosmo_v2/cosmo_v2",
      // To open an image on launch, add its path here, e.g.:
      //   "args": ["${workspaceFolder}/some/photo.jpg"],
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "cosmo_v2: build",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
