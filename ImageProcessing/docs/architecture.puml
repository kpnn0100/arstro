@startuml arstro_image_architecture
'  Arstro ImageProcessing Library — architecture (the image-domain mirror of the
'  DSP library). This diagram is the design surface: keep it in sync with the code.
'  M1 implements Exposure + Contrast; later tone/color/effect/transform processors
'  slot into their reserved positions in the EditEngine pipeline.
title Arstro ImageProcessing — Class Architecture (M4a: full processor catalog)

skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

' ─────────────────────────── Foundation ───────────────────────────
package base {
  class ImageConfig <<singleton>> {
    + {static} instance() : ImageConfig&
    + workingSpace() : ColorSpace
    + maxPreviewEdge() : int
    + clampToUnit() : bool
    + setWorkingSpace(ColorSpace)
  }

  class Image {
    + width()/height()/channels() : int
    + pixelCount() : size_t
    + space() : ColorSpace
    + at(x,y,c) : Pixel
    + sampleBilinear(x,y,c) : Pixel
    + clone() / resizeLike(other)
  }

  abstract class ImageProcessor {
    + apply(in : Image, out : Image)
    + {abstract} process(in : Image, out : Image)
    + update()
    + setProperty(id, value)
    + getProperty(id) : Pixel
    + setBypass(b) / isBypassed()
    # mParams : ParameterSet
  }

  abstract class PointProcessor {
    + process(in, out)  ' shared per-pixel loop
    # {abstract} processPixel(in*, out*, channels)
  }

  class ImageSource {
    + {abstract} generate() : Image
    + process(in, out)  ' = generate()
  }

  class ImageBlock {
    + add(p) / remove(p) / clear()
    + process(in, out)  ' runs the ordered chain
  }

  class SmoothedParameter {
    + last / target / current : Pixel
    + setTarget(v) / beginRamp() / interpolate(r) / snap()
  }
  class ParameterSet {
    + resize(n) / init(id,v) / setTarget(id,v) / snap(id)
    + interpolate(r) / snapAll()
  }

  ImageProcessor o-- ParameterSet
  ParameterSet o-- SmoothedParameter
  PointProcessor --|> ImageProcessor
  ImageSource --|> ImageProcessor
  ImageBlock --|> ImageProcessor
}

package "base::color" as colorspace {
  class ColorSpace_fns <<functions>> {
    + srgbEncode/srgbDecode(Pixel) : Pixel
    + encodeInPlace(Image&) / decodeInPlace(Image&)
    + luminance(r,g,b) : Pixel
    + rgbToHsl(...) / hslToRgb(...)
    + kelvinToRgbGain(K, tint, &gr, &gg, &gb)
    + hueDelta(a, b) : Pixel
  }
}

' ─────────────────────────── Sources ───────────────────────────
package source {
  class SolidImageSource
  class FileImageSource {
    + setEncodedBytes(bytes, w, h, ch)
    + generate() : Image
  }
  SolidImageSource --|> ImageSource
  FileImageSource --|> ImageSource
}

' ─────────────────────────── Processors ───────────────────────────
package tone {
  class Exposure {
    + setExposureEv(ev)  ' 2^EV (linear)
  }
  class Contrast {
    + setContrast(v)  ' slope around 0.18 pivot
  }
  class ToneRegions {
    + setHighlights/Shadows/Whites/Blacks(v)
  }
  class ToneCurve {
    + setPoints(pts)  ' RGB master, 1024-LUT
    + setChannelPoints(ch, pts)  ' per-channel R/G/B
    + setLogScale(b)
  }
  Exposure --|> PointProcessor
  Contrast --|> PointProcessor
  ToneRegions --|> PointProcessor
  ToneCurve --|> PointProcessor
}

package color {
  class WhiteBalance {
    + setTemperature(K) / setTint(v)
  }
  class Vibrance {
    + setVibrance(v) / setSaturation(v)
  }
  class ColorMixer {
    + setCurve(Hue/Sat/Lum, points)  ' 3 cyclic per-hue LUTs
  }
  class ColorGrading {
    + setGradeHue/Sat/Lum(region) / setHueRemap(...)
  }
  WhiteBalance --|> PointProcessor
  Vibrance --|> PointProcessor
  ColorMixer --|> PointProcessor
  ColorGrading --|> PointProcessor
}

package effect {
  class Dehaze {
    + setAmount(v)  ' dark-channel prior
  }
  class Grain {
    + setAmount(v) / setSize(v) / setSeed(s)
  }
  class Texture {
    + setAmount(v)  ' fine-radius local contrast
  }
  class Clarity {
    + setAmount(v)  ' large-radius midtone local contrast
  }
  Dehaze --|> ImageProcessor
  Grain --|> ImageProcessor
  Texture --|> ImageProcessor
  Clarity --|> ImageProcessor
}

package detail {
  class Sharpen {
    + setAmount(v) / setRadius(px) / setMasking(v)  ' unsharp on perceptual luma
  }
  class NoiseReduction {
    + setLuminance(v) / setColor(v)  ' bilateral luma + chroma blur
  }
  Sharpen --|> ImageProcessor
  NoiseReduction --|> ImageProcessor
}

package transform {
  class Crop {
    + setRect(x,y,w,h)  ' normalized
  }
  class Rotate {
    + setAngle(deg) / setQuarterTurns(n)
  }
  class LensCorrection {
    + setDistortion(v) / setChromaticAberration(v) / setVignette(v)
  }
  Crop --|> ImageProcessor
  Rotate --|> ImageProcessor
  LensCorrection --|> ImageProcessor
}

' ─────────────────────────── Analysis / Video / Engine ───────────────────────────
package analysis {
  class Histogram <<sink>> {
    + {static} compute(Image) : HistogramData
    + {static} toLog(...) / toLinear(...)
  }
  class HistogramData {
    + r/g/b/lum : uint32[256]
    + maxCount : uint32
  }
}

package video {
  class VideoProcessor {
    + setProcessor(p)
    + processFrame(Image) : Image
    + enableSmoothing(b) / reset()
  }
  VideoProcessor o-- ImageProcessor
}

package engine {
  class MaskParams {
    + type / inverted / feather / geometry / dabs[] / adjust:LocalAdjust
  }
  class MaskStack <<free fn>> {
    + maskCoverage(m,nx,ny) / applyMaskStack(img, masks[])
  }
  MaskStack ..> MaskParams
  class composeParams <<free fn>> {
    + (base, over) : EditParams
  }
  note bottom of composeParams
    stack params (cosmo group settings): scalars add,
    tone/mixer curves add in Y, masks concat, crop per-item
  end note
  class EditEngine <<facade>> {
    + addImage(rgba, w, h, ch) : int / selectImage(slot)
    + setExposure/Contrast/Highlights/Shadows/Whites/Blacks(v)
    + setTemperature/Tint/Vibrance/Saturation/Dehaze/Grain*(v)
    + setCurvePoints(pts) / setMixerCurve(channel, pts) / setGrade*(region) / setHueRemap(...)
    + setCrop(x,y,w,h) / setRotation(deg) / setQuarterTurns(n)
    + setBypass(b) / resetAll() / setPreviewSize(maxEdge)
    + renderPreview() / renderFull() : PreviewBuffer
    + histogram() : HistogramData
    + setPreferGpu(b) / gpuAvailable() : bool  ' opt-in GPU accel; CPU is the fallback
  }
  EditEngine *-- ImageBlock
  EditEngine *-- Crop
  EditEngine *-- Rotate
  EditEngine *-- Exposure
  EditEngine *-- Contrast
  EditEngine *-- ToneRegions
  EditEngine *-- WhiteBalance
  EditEngine *-- ToneCurve
  EditEngine *-- Vibrance
  EditEngine *-- ColorMixer
  EditEngine *-- ColorGrading
  EditEngine *-- Dehaze
  EditEngine *-- Grain
  EditEngine ..> Histogram
}

package compute {
  interface IComputeBackend {
    + name() : string
    + kind() : Kind
    + available() : bool
    + process(src, params, out) : bool
  }
  note right of IComputeBackend
    optional accelerator; false = decline -> CPU
  end note
  class ComputeResult {
    + processed : Image
    + finalHist : HistogramData
    + preCurveHist : HistogramData
    + preMixerHue : HueHistogram
  }
  class createComputeAccelerator <<factory fn>>
  class GlComputeBackend {
    + process(src, params, out) : bool
  }
  note bottom of GlComputeBackend
    OpenGL 4.3 compute / surfaceless EGL (Linux/AMD)
    exposure+contrast+WB+encode on GPU; declines the rest to CPU
  end note
  GlComputeBackend ..|> IComputeBackend
  IComputeBackend ..> ComputeResult
  createComputeAccelerator ..> GlComputeBackend
}
' optional accelerator; the CPU pipeline in EditEngine is the reference + guaranteed fallback (R-GPU)
EditEngine o--> IComputeBackend

@enduml
