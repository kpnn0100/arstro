{
  "genesis": 1,
  "component": {
    "name": "PillButton",
    "base": "Button",
    "namespace": "app",
    "designSize": [
      132,
      36
    ]
  },
  "params": [
    {
      "name": "accent",
      "type": "color",
      "default": "#9a7bff"
    },
    {
      "name": "surface",
      "type": "color",
      "default": "#232029"
    }
  ],
  "shapes": [
    {
      "id": "body",
      "type": "rect",
      "bind": {
        "x": "0",
        "y": "0",
        "w": "w",
        "h": "h",
        "fill": "mix(surface, accent, base.hover * 0.5)",
        "cornerRadius": "6",
        "pivotX": "self.w / 2",
        "pivotY": "self.h / 2"
      },
      "animated": [
        "scaleX",
        "scaleY"
      ]
    },
    {
      "id": "wash",
      "type": "rect",
      "parent": "body",
      "bind": {
        "x": "0",
        "y": "0",
        "w": "self.h * 0",
        "h": "body.h",
        "fill": "fade(#ffffff, 0.18)",
        "cornerRadius": "6",
        "opacity": "0"
      },
      "animated": [
        "opacity"
      ]
    }
  ],
  "reactions": [
    {
      "on": "pressDown",
      "cancel": "restart",
      "steps": [
        [
          {
            "target": "body.scaleX",
            "to": "0.96",
            "ms": "90",
            "easing": "EaseOutCubic"
          },
          {
            "target": "body.scaleY",
            "to": "0.96",
            "ms": "90",
            "easing": "EaseOutCubic"
          },
          {
            "target": "wash.opacity",
            "from": "0",
            "to": "1",
            "ms": "90",
            "easing": "EaseOutCubic"
          }
        ]
      ]
    },
    {
      "on": "release",
      "cancel": "restart",
      "steps": [
        [
          {
            "target": "body.scaleX",
            "to": "1",
            "ms": "180",
            "easing": "EaseOutBack"
          },
          {
            "target": "body.scaleY",
            "to": "1",
            "ms": "180",
            "easing": "EaseOutBack"
          },
          {
            "target": "wash.opacity",
            "to": "0",
            "ms": "180",
            "easing": "EaseOutCubic"
          }
        ]
      ]
    },
    {
      "on": "cancel",
      "cancel": "restart",
      "steps": [
        [
          {
            "target": "body.scaleX",
            "to": "1",
            "ms": "180",
            "easing": "EaseOutBack"
          },
          {
            "target": "body.scaleY",
            "to": "1",
            "ms": "180",
            "easing": "EaseOutBack"
          },
          {
            "target": "wash.opacity",
            "to": "0",
            "ms": "180",
            "easing": "EaseOutCubic"
          }
        ]
      ]
    }
  ]
}
