# The languages' tables compiled INTO the binary (R-ACCESS-2, Round 21) — the app's words, like its fonts (cosmo's
# embed_fonts.cmake, the same trick), are not a thing that may differ between machines.
#
# Run as: cmake -DTABLES="<path>;<path>;..." -DOUT=<file.cpp> -P embed_strings.cmake
if(NOT DEFINED OUT)
  message(FATAL_ERROR "embed_strings.cmake needs -DTABLES=... and -DOUT=...")
endif()
set(body "")
set(table "")
set(index 0)
foreach(path IN LISTS TABLES)
  get_filename_component(name "${path}" NAME)
  file(READ "${path}" hex HEX)
  string(LENGTH "${hex}" hexlen)
  math(EXPR bytes "${hexlen} / 2")
  string(REGEX REPLACE "(..)" "0x\\1," data "${hex}")
  string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" data "${data}")
  string(APPEND body "// ${name} — ${bytes} bytes\nconst unsigned char kTable${index}[] = {\n${data}0x00\n};\n\n")
  string(APPEND table "        {\"${name}\", kTable${index}, ${bytes}},\n")
  math(EXPR index "${index} + 1")
endforeach()
if(index EQUAL 0)
  set(table "        {\"\", nullptr, 0},\n")
endif()
file(WRITE "${OUT}" "// GENERATED by strings/embed_strings.cmake — do not edit, and do not commit.
#include \"Embedded.h\"

namespace arstro
{
namespace solaris_strings
{
${body}    const EmbeddedTable kEmbedded[] = {
${table}    };
    const int kEmbeddedCount = ${index};
}
}
")
