# R-SVC-13: an original trap / EDM track, made with solaris-cc alone and measured as a master. song.txt must be what
# demo/trap/make_script.py writes; it must run to the end; its render must pass measure.py (loudness, true peak, the gap,
# the form, the field, the pump, the grid, the key, the range). Run by ctest as trap_track_measured (label long)
# with -DCC=<solaris-cc> -DDEMO=<apps/solaris/demo/trap> -DWORK=<a scratch folder> [-DPY=<python3>].
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(ENV{SOLARIS_SETTINGS} "${WORK}/settings.txt") # never the user's own files
set(ENV{SOLARIS_RECENTS} "${WORK}/recents")
file(COPY "${DEMO}/song.txt" DESTINATION "${WORK}")
if(PY)
  execute_process(COMMAND "${PY}" -I "${DEMO}/make_script.py" "${WORK}/regenerated.txt" RESULT_VARIABLE rc OUTPUT_QUIET)
  file(READ "${WORK}/regenerated.txt" want)
  file(READ "${DEMO}/song.txt" have)
  if(NOT rc EQUAL 0 OR NOT want STREQUAL have)
    message(FATAL_ERROR "demo/trap/song.txt is stale — run: python3 make_script.py (in demo/trap)")
  endif()
endif()
execute_process(COMMAND "${CC}" --script song.txt WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "the song script failed (exit ${rc}):\n${err}\n${out}")
endif()
foreach(f magnetar.slp magnetar.wav magnetar.ch_2.wav magnetar.ch_3.wav magnetar.ch_4.wav magnetar.ch_5.wav magnetar.ch_12.wav)
  if(NOT EXISTS "${WORK}/${f}")
    message(FATAL_ERROR "the song script did not write ${f}")
  endif()
endforeach()
if(PY)
  execute_process(COMMAND "${PY}" -c "import numpy, scipy" RESULT_VARIABLE has_libs OUTPUT_QUIET ERROR_QUIET)
endif()
if(NOT PY OR NOT has_libs EQUAL 0)
  message(STATUS "trap_track_measured: no python3 with numpy and scipy — made, not measured")
  return()
endif()
execute_process(COMMAND "${PY}" -I "${DEMO}/measure.py" "${WORK}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
message(STATUS "${out}")
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "Magnetar does not measure as a master:\n${out}${err}")
endif()
