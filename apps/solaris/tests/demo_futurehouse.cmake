# R-SVC-16: an original electro / future house track in the NCS style, made with solaris-cc alone and measured as a
# master. song.txt must be what demo/futurehouse/make_script.py writes; it must run to the end; its render must pass
# measure.py (loudness, true peak, the form, the gap, the floor, the bounce, the pump on the grid, the hook, the field,
# the key, the shine). Run by ctest as futurehouse_track_measured (label long)
# with -DCC=<solaris-cc> -DDEMO=<apps/solaris/demo/futurehouse> -DWORK=<a scratch folder> [-DPY=<python3>].
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(ENV{SOLARIS_SETTINGS} "${WORK}/settings.txt") # never the user's own files
set(ENV{SOLARIS_RECENTS} "${WORK}/recents")
file(COPY "${DEMO}/song.txt" DESTINATION "${WORK}")
if(PY)
  execute_process(COMMAND "${PY}" -I "${DEMO}/make_script.py" "${WORK}/regenerated.txt" RESULT_VARIABLE rc OUTPUT_QUIET)
  file(READ "${WORK}/regenerated.txt" want)
  file(READ "${DEMO}/song.txt" have)
  if(NOT rc EQUAL 0 OR NOT want STREQUAL have)
    message(FATAL_ERROR "demo/futurehouse/song.txt is stale — run: python3 make_script.py (in demo/futurehouse)")
  endif()
endif()
execute_process(COMMAND "${CC}" --script song.txt WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "the song script failed (exit ${rc}):\n${err}\n${out}")
endif()
foreach(f starward.slp starward.wav starward.ch_2.wav starward.ch_3.wav starward.ch_8.wav starward.ch_9.wav starward.ch_11.wav)
  if(NOT EXISTS "${WORK}/${f}")
    message(FATAL_ERROR "the song script did not write ${f}")
  endif()
endforeach()
if(PY)
  execute_process(COMMAND "${PY}" -c "import numpy, scipy" RESULT_VARIABLE has_libs OUTPUT_QUIET ERROR_QUIET)
endif()
if(NOT PY OR NOT has_libs EQUAL 0)
  message(STATUS "futurehouse_track_measured: no python3 with numpy and scipy — made, not measured")
  return()
endif()
execute_process(COMMAND "${PY}" -I "${DEMO}/measure.py" "${WORK}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
message(STATUS "${out}")
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "Starward does not measure as a master:\n${out}${err}")
endif()
