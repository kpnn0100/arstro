@startuml cosmo-architecture
title cosmo — Architecture (as-built)
skinparam classAttributeIconSize 0
hide empty members

' ─────────────────────────────────────────────────────────────
' Layers (top = platform edge, bottom = platform-free libraries)
' ─────────────────────────────────────────────────────────────

package "host (linux_main.cpp)  <<GTK/Cairo>>" as host {
  class GtkMain <<(F,#f88) entry>> {
    + main()
    - onDraw/onButton/onMotion/onScroll/onKey/onTick
  }
  class LoadJob <<load, host half>> {
    + loader : ProjectLoader        ' the decode moved down (R-SVC-1)
    + nodeOf : int[]                ' entry index -> tree node (R-LOADUX-1)
    + entryCount : size_t
    + pollId : guint                ' GTK 15 ms consumer
    - startEntriesLoad() / pollLoad()
  }
  class OmpPin <<namespace, host>> {
    + pinNestedOpenMPForThisThread()  ' per-worker; per-thread ICV (D-12)
    + ompPinStatus() : const char *   ' checked at runtime, not assumed
  }
  class "file dialogs" as Dialogs <<GTK>>
  class ExportWriter <<namespace exporter>> {
    + resolvePath(req, sourcePath, fallbackName) : string
    + write(req, rgba, w, h, path, sourcePath, error) : bool
    - readJpegApp1/stripGps/injectApp1
    - addPngSrgbChunks
    - kSrgbIcc : byte[468]
  }
  class ExportJob <<idle pump>> {
    + req : ExportDialog::Request
    + index : size_t
    - exportStep()  ' one image per main-loop step (R-EXPORT-6)
  }
  class CairoTarget <<adapter>>
}

package "app  (namespace arstro::cosmo_v2)" as app {
  class App {
    - mScreen : Screen
    - mPhase : Phase
    - mSession : cosmo::EditSession
    + render(target, nowMs)
    + pointer/wheel/key
    + beginOpenTransition/finishOpenTransition/beginReveal
    + showHome/showEditor/resetWorkspace
    - renderEditor/renderTransition/renderReturn
    - drawWordmark(p, alpha)
    .. host callbacks ..
    + onOpenRecentRequested / onDecodeThumbnail / onSettingsChanged ...
  }
  enum Screen {
    Home
    Loading
    Editor
  }
  enum Phase {
    None
    Intro
    Loading
    Reveal
    ReturnEnter
    ReturnLoad
    ReturnExit
  }

  package widgets {
    class TopBar
    class MenuStrip
    class LeftRail
    class PresetTree
    class CenterStage
    class PhotoCanvas
    class MaskOverlay
    class Filmstrip
    class Breadcrumb
    class RightColumn
    class EditStackTabs
    class HistogramWidget
    class ParamPanel
    class MixerPanel
    class HueCurveEditor
    class CurvePanel
    class GradePanel
    class XformPanel
    class MaskPanel
    class StackPanel
    class ActionBar
    class HomeScreen
    class HistoryView
    class ContextMenu
    class PresetDialog
    class SettingsDialog {
      + show(previewEdge, threads, cpuPercent, useGpu, gpuAvailable)
      + onPreviewEdge / onThreads / onUseGpu : cb
      + onCpuPercent(int) : cb   ' R-CPU-3: the CPU budget row
      + advance() / onOverlay()  ' public: Home drives it too (R-SETTINGS-5)
    }
    class ConfirmDialog
    class ExportDialog {
      + show(nodes, preselect)
      + rowCount/rowIsGroup/rowState
      + toggleRow/toggleExpand/setAllChecked
      + selectedSlots() : int[]
      + setDestination/setExportProgress/cancelExport
      + onChooseDestination : cb
      + onExport(Request) : cb
      - mLeafChecked : char[]   ' leaves are authoritative; groups derive
      - mRows/mKids/mExpanded
    }
    class "ExportDialog::Node" as ExportNode <<struct>>
    class "ExportDialog::Request" as ExportRequest <<struct>>
    class SliderRow
    class SegmentedControl
    class PillButton
    class IconButton
    class HoverFade <<helper>>
    class Starfield <<helper>>
  }
}

package "cosmo_core  (namespace arstro::cosmo)  <<UI-free>>" as core {
  class EditSession {
    - mNodes : GNode[]
    - mSlotParams/History/Names/Paths/Thumbs : []
    - mService : RenderService
    + openImage/openImageInto/selectNode/navigateToGroup
    + curParams/effectiveParams/applyParams/submit
    + isBypassed/setBypassed/toggleBypass/setSlotBypass
    + editTargetNode/editTargetBypassed
    + exportFullRes/exportFullResSlot
    + sourcePathForSlot/nameForSlot
    + undo/redo/jumpToHistory
    + saveWorkspaceAs/readWorkspaceFile/resetWorkspace
    + savePreset/applyPreset/importPresetFrom
  }
  class GNode <<group-tree node>>
  class History {
    + nodes : HistoryNode[]
    + current : int
    + record/undo/redo/jumpTo/restore/prune
  }
  class HistoryNode
  class ProjectStore <<static>> {
    + recents() / remember(RecentEntry)
    + configDir()
  }
  class PresetLibrary <<static>> {
    + scan(dir) : PresetNode[]
  }
  class AppSettings {
    + previewEdge : int
    + threads : int          ' 0 = auto -> the CPU budget (R-CPU-2b)
    + useGpu : bool
    + cpuPercent : int       ' R-CPU-1: share of cores cosmo may schedule
    + load() / save()
    + workersFor(percent, cap) : int   ' legacy: ThreadBudget owns the conversion now
  }
  class ThreadBudget <<one owner, R-SVC-10>> {
    + {static} kMaxDecodeWorkers : int = 8   ' R-CPU-5: the cap can bind first
    + {static} kEngineFloor : int = 1
    + setPercent(p) / setExplicitEngineThreads(n)
    + total() : int                  ' the ONE number every slice comes from
    + decodeWorkers() : int          ' total - engine floor, capped
    + engineThreads() : int          ' total - reserved (whole budget when idle)
    + beginLoad() : int / endLoad()  ' reserve for a load's duration
    + apply()                        ' the only par::setThreads for the budget
    + producerEnter() / producerExit() / peakDecode() : int   ' MEASURED (R-CPU-4)
  }
  class "OrderedParallelLoad<T>" as OrderedParallelLoad <<template>> {
    + start(count, workers, window, maxBytes, produce, weigh, onWorkerStart)
    + tryConsume(T &) : bool         ' one consumer, strict index order
    + consumed() / count() / finished()
    + stop()
    - run()                          ' claim with an atomic; i == mConsumed is exempt
  }
  class ProjectLoader <<decode pool, R-SVC-1>> {
    + {static} kDecodeWindow : size_t = 8
    + {static} kMaxInFlightBytes : size_t = 512 MB
    + start(entries, budget, makeDecoder, onWorkerStart)
    + poll(Result &) : bool          ' strictly in entry order
    + finished() / consumed() / total() / workers()
    + stop()
    - produce(i, decoder) : Result   ' decode + thumbnail, on the worker (R-LOADPERF-2)
  }
  AppSettings ..> ProjectStore : configDir()
  interface IImageDecoder
  class NativeImageDecoder
  NativeImageDecoder ..|> IImageDecoder
}

package "ImageProcessing  (namespace arstro)  <<headless engine>>" as engine {
  class RenderService <<worker thread>> {
    + addImage/releaseImage/reset/setPreviewSize
    + render(slot, EditParams)   <<coalesced>>
    + tryAcquire(Frame&) : bool
    + renderFull / renderPreviewSync
  }
  class Frame
  class EditEngine <<fixed pipeline>>
  class EditParams
  class CurvePoint
  class MaskParams
}

package "Artboard  (namespace artboard)  <<platform-free UI framework>>" as artboard {
  class Segment
  class "AnimatedProperty" as Prop
  interface IRenderTarget
  class GestureRecognizer
  class ImageView
  class Slider
  class Theme
}

' ─────────────────────────────────────────────────────────────
' Relationships
' ─────────────────────────────────────────────────────────────
GtkMain *--> App
GtkMain *--> LoadJob
GtkMain *--> CairoTarget
GtkMain ..> Dialogs
LoadJob ..> NativeImageDecoder
CairoTarget ..|> IRenderTarget

App *--> TopBar
App *--> LeftRail
App *--> CenterStage
App *--> RightColumn
App *--> HomeScreen
App *--> HistoryView
App *--> ContextMenu
App *--> PresetDialog
App *--> SettingsDialog
App *--> ExportDialog
App *--> ConfirmDialog
App *--> Starfield
App o--> Screen
App o--> Phase
App *--> EditSession

TopBar *--> MenuStrip
LeftRail *--> PresetTree
CenterStage *--> PhotoCanvas
CenterStage *--> Breadcrumb
CenterStage *--> Filmstrip
PhotoCanvas *--> MaskOverlay
PhotoCanvas *--> SegmentedControl
RightColumn *--> HistogramWidget
RightColumn *--> EditStackTabs
RightColumn *--> ActionBar
RightColumn --> EditSession : "reads/writes params"
EditStackTabs *--> ParamPanel
EditStackTabs *--> StackPanel
EditStackTabs *--> GradePanel
EditStackTabs *--> XformPanel
EditStackTabs *--> MaskPanel
StackPanel *--> MixerPanel
StackPanel *--> CurvePanel
MixerPanel *--> HueCurveEditor
ParamPanel *--> SliderRow
GradePanel *--> SliderRow
MaskPanel *--> SliderRow

widgets --|> Segment
Segment *--> Prop
Segment ..> IRenderTarget : emits ops
Segment ..> Theme

ExportDialog *--> ExportNode
ExportDialog ..> ExportRequest : emits on Export
ExportWriter ..> ExportRequest : encodes per
ExportJob ..> ExportWriter : one image per idle step
ExportJob ..> ExportRequest

EditSession *--> GNode
GNode : + bypass : bool   ' R-BYPASS-1
GNode *--> EditParams : own settings (groups)
GNode *--> History : own timeline (groups)
EditSession *--> History
EditSession *--> RenderService
History *--> HistoryNode
App ..> ProjectStore
App ..> PresetLibrary
App ..> AppSettings : applySettings (no thread count — R-SVC-10)
GtkMain ..> ThreadBudget : setPercent / setExplicitEngineThreads (R-CPU-3)
LoadJob *--> ProjectLoader
ProjectLoader ..> ThreadBudget : beginLoad / producerEnter (R-SVC-10)
ProjectLoader ..> OrderedParallelLoad : pool + in-order hand-off
ProjectLoader ..> IImageDecoder : one per produce() call
ProjectLoader ..> OmpPin : onWorkerStart hook (R-CPU-2c)
ThreadBudget ..> RenderService : par::setThreads(engineThreads())
HomeScreen ..> SettingsDialog : sidebar Settings link (R-SETTINGS-5)
RenderService ..> EditEngine
RenderService ..> Frame
EditEngine ..> EditParams
EditParams *--> CurvePoint
EditParams *--> MaskParams

@enduml
