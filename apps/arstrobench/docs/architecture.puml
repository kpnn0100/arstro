@startuml arstrobench
title Arstrobench — class model

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "host (platform)" {
  class native_main <<file>> {
    + main(argc, argv) : int
    - onDraw(cairo_t*) : gboolean
    - onTick() : gboolean
    - onButton(GdkEventButton*) : gboolean
    - onMotion(GdkEventMotion*) : gboolean
    - registerBundledFonts() : void
  }
}

package "arstro::arstrobench (UI — platform-free)" {
  class BenchApp {
    + BenchApp(width, height)
    + render(IRenderTarget&, nowMs) : void
    + pointer(kind, x, y, button, timeMs) : void
    + startRun() : void
    + isRunning() const : bool
    + showResult(Kind, WorkloadResult, nowMs) : void
    - mRoot : shared_ptr<Segment>
    - mRunner : BenchmarkRunner
    - mSystem : SystemInfo
  }
  class ScoreCard {
    + setTitle(string) : void
    + setAccent(Color) : void
    + setDetail(string) : void
    + setState(State, nowMs) : void
    + showScore(score, seconds, nowMs) : void
    - mShownScore : Property
    - mStateFade : Property
    - onPaint(IRenderTarget&) : void
  }
  class TotalCard {
    + showScore(total, nowMs) : void
    - mShownScore : Property
  }
  class SystemPanel {
    + setInfo(SystemInfo) : void
    - onPaint(IRenderTarget&) : void
  }
  class RunButton {
    + onClick : function<void()>
    + setLabel(string) : void
    - mPress : Property
    - handleGesture(Gesture&, Point&) : bool
  }
  class GpuToggle {
    + onChange : function<void(bool)>
    + on() const : bool
    + setUnavailable(bool) : void
    - mSwitch : ToggleSwitch
    - mOnAmount : Property
  }
}

package "arstro::arstrobench (core — UI-free)" {
  class WorkloadResult <<struct>> {
    + seconds : double
    + score : double
    + checksum : double
    + detail : string
    + ok : bool
    + {static} fromSeconds(seconds) : WorkloadResult
  }
  class ImageWorkload {
    + {static} kWidth = 1920
    + {static} kHeight = 1080
    + {static} kPasses = 3
    + ImageWorkload(w, h, passes, preferGpu)
    + run() : WorkloadResult
    + setPreferGpu(bool) : void
    + {static} gpuAvailable() : bool
    + {static} backendText(preferGpu, accelerated, name) : string
    + {static} makeDummyPixels(w, h) : vector<uint8_t>
    + {static} benchParams() : EditParams
  }
  class DspWorkload {
    + {static} kVoices = 9
    + {static} kFrames = 192000
    + {static} kPasses = 3
    + DspWorkload(frames, passes)
    + run() : WorkloadResult
    + generate() : vector<vector<vector<Sample>>>
  }
  class SystemInfo <<struct>> {
    + chip : string
    + threads : int
    + ramBytes : uint64
    + os : string
    + {static} query() : SystemInfo
    + ramText() const : string
    + chipText() const : string
  }
  class BenchmarkRunner {
    + start() : void
    + setPreferGpu(bool) : void
    + stage() const : Stage
    + running() const : bool
    + snapshot() const : Snapshot
    - mThread : std::thread
    - mStage : atomic<Stage>
    - mMutex : mutex
  }
  enum Stage {
    Idle
    Image
    Dsp
    Done
  }
  class Snapshot <<struct>> {
    + image : WorkloadResult
    + dsp : WorkloadResult
    + total : double
  }
}

package "artboard" {
  abstract class Segment
  abstract class ProgressIndicator
  interface IRenderTarget
  class CairoTarget
  class GestureRecognizer
}

package "arstro::arstrobench (the measured mix — DspChain.h)" {
  class MixChain {
    + MixChain(voices, frames, channels)
    + process(voiceBuffers) : vector<vector<Sample>>&
    + stageCount() const : int
  }
  class VoiceStrip {
    + process(buf, frames, channel, scratch) : void
  }
  class MultibandCompressor {
    + {static} kBands = 4
    + process(buf, frames, channel, bandScratch) : void
  }
  class ParametricEq {
    + process(buf, frames, channel, scratch) : void
  }
  class ReverbSection {
    + process(buf, frames, channel, wet) : void
  }
  class "Cascade<Filter>" as Cascade {
    + Cascade(order, cutoffHz)
    + process(buf, frames, channel) : void
  }
}

package "arstro (engines)" {
  class EditEngine
  class EditParams <<struct>>
  class Voice
  class Compressor
  class Overdrive
  class Chorus
  class Reverb
}
class LowPassFilter
class HighPassFilter

native_main --> BenchApp
native_main --> CairoTarget
CairoTarget ..|> IRenderTarget

BenchApp *-- "1" RunButton
BenchApp *-- "1" GpuToggle
BenchApp *-- "2" ScoreCard
BenchApp *-- "1" TotalCard
BenchApp *-- "1" SystemPanel
BenchApp *-- "1" BenchmarkRunner
BenchApp o-- GestureRecognizer

ProgressIndicator --|> Segment
ScoreCard --|> ProgressIndicator
GpuToggle --|> Segment
TotalCard --|> Segment
SystemPanel --|> Segment
RunButton --|> Segment

BenchmarkRunner *-- ImageWorkload
BenchmarkRunner *-- DspWorkload
BenchmarkRunner --> SystemInfo
BenchmarkRunner +-- Snapshot
BenchmarkRunner --> Stage
Snapshot *-- WorkloadResult

GpuToggle ..> ImageWorkload : availability
ImageWorkload --> EditEngine
ImageWorkload --> EditParams
ImageWorkload ..> WorkloadResult
DspWorkload --> Voice
DspWorkload --> MixChain
DspWorkload ..> WorkloadResult

MixChain *-- "9" VoiceStrip
MixChain *-- "1" MultibandCompressor
MixChain *-- "1" ParametricEq
MixChain *-- "1" ReverbSection
MixChain *-- "1" Compressor
VoiceStrip *-- Cascade
VoiceStrip --> Compressor
VoiceStrip --> Overdrive
VoiceStrip --> LowPassFilter
VoiceStrip --> HighPassFilter
MultibandCompressor *-- Cascade
MultibandCompressor --> Compressor
MultibandCompressor --> Overdrive
ParametricEq *-- Cascade
ParametricEq --> LowPassFilter
ParametricEq --> HighPassFilter
ReverbSection --> Reverb
ReverbSection --> Chorus
ReverbSection --> LowPassFilter
Cascade --> LowPassFilter
Cascade --> HighPassFilter

ScoreCard ..> WorkloadResult
SystemPanel ..> SystemInfo

note right of WorkloadResult
  score = 1 / seconds   (R-SCORE-1)
  seconds = fastest of N passes (R-SCORE-3)
  generation never timed (R-SCORE-2)
end note

note bottom of ScoreCard
  Inherits ProgressIndicator so the
  running sweep + spring-smoothed
  fill come from the framework
  (R-UI-6), not re-implemented.
end note
@enduml
