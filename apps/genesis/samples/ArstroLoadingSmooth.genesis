        "stroke": "theme.accent",
        "strokeWidth": "rect.strokeWidth"
      },
      "reactions": [
        {
          "on": "loopStart",
          "cancel": "restart",
          "steps": [
            [
              {
                "target": "w",
                "to": "minSide*0.2",
                "ms": "1000",
