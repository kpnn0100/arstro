@startuml
' Genesis — structure. The arrow never points upward, and nothing below
' `genesis_core` knows the editor exists.
skinparam shadowing false
skinparam classAttributeIconSize 0

package "genesis (editor)" {
  class App {
    + documentChanged()  ' the ONE edit funnel
    + newDocument() / openDocument() / saveDocument()
    + exportCode() / startVerify()
    + selectShape() / selectReaction()
    + status(msg, level)
  }
  class Chrome
  class ListScroll <<value>> {
    + measure(viewportH, contentH)  ' every layout, G-20
    + offset() / maxOffset() / scrollable()
    + wheel(dy) : bool  ' false when nothing to scroll -> bubbles (FR-46)
    + drag(dy) / reset()
    + drawBar(t, area)  ' only while scrollable
  }
  class ShapeTree
  class CanvasView {
    + frameW() / frameH()  ' the preview frame, resized independently of the window
    + setHoverSim(on)
  }
  class Inspector
  class ReactionsPanel {
    - mDrag : TrackDrag  ' a track being dragged by its grip (G-23)
    - gripAt(p) / dropTargetAt(y, step, index)
  }
  class Modal {
    + openNew() / openSaveAs() / openReport()
    + coversApp()  ' overlay-pass panels check this
  }
  class RowHover
  ShapeTree *--> ListScroll : objects
  Inspector *--> ListScroll : properties
  ReactionsPanel *--> "2" ListScroll : reactions + tracks
  class TextUtil <<utility>> {
    + setMeasureTarget(t)
    + textWidth() / ellipsize()
  }
  class "ui::Theme" as UiTheme <<tokens>> {
    palette:: radius:: type:: metrics::
  }
}

package genesis_core {
  class Document {
    + params / shapes / reactions
    + validate() : Diagnostic[]
    + expandSteps(r, ownerId) : Step[]  ' `all` -> one track per field (G-22)
    + animatedFields(shapeId) : string[]  ' derived; there is no mark (G-21)
    + isAnimated(shapeId, field)
    + {static} moveTrack(r, fromStep, fromTrack, toStep, toIndex)  ' G-23
    + {static} followsTarget(t)  ' G-6b: a non-constant `to` is re-read every frame
    + {static} releasesToBinding(t)  ' G-22: ...and a bare `original` also hands the field back
    + toJson() / fromJson() / load() / save()
    + {static} starter(base, name)
  }
  class Shape
  class Param
  class Reaction {
    + loopFrom / loopTo / loopCount  ' G-26: the chain repeats a range of its steps
    + loops() : bool
  }
  class Step
  class Track
  class FieldDef <<the one field table>>
  class BaseDef
  class SignalDef
  class BaseRead
  class Json
  class "gene::Node" as GeneNode
  class "gene::Value" as GeneValue
  class "gene::" as Gene <<namespace>> {
    + parse(src) : Node
    + fold(node)
    + evaluate(node, scope) : Value
    + emitCpp(node, names) : string
    + collectMembers() / collectIdents()
  }
  class CppEmitter {
    + emitCpp(doc) : EmittedCode
    + writeEmitted(code, dir)
  }
  class Runtime {
    + fieldValue(shape, field, out, whence) : bool  ' G-24: the live value + who wrote it
    + releaseProgress(shape, field) : double
    + stepTimings(shape, signal) : StepTiming[]  ' G-27: start + length per step
    + reactionDurationMs(shape, signal) : double  ' their sum
    - applyReleases()  ' G-6b: blend toward `to`, re-evaluated each frame, and rest on it
  } {
    + build(doc) : bool
    + root() : Segment
    + advance(nowMs) / setSize(w,h)
    + fire(signal) / isRunning(signal)
    + loopStart() / setProgress() / setPressed() / toggleChecked()
    + setParamNumber() / setParamColor()
  }
  class Verifier {
    + verify(doc, plan, cfg) : VerifyResult
    + opsToText(ops)
  }
  class "Host<Base>" as Host
}

package artboard_core {
  class Segment
  class Property
  class Tween
  class RecordingTarget
  class VisualLoop
  class ProgressIndicator
}

App *--> Chrome
App *--> ShapeTree
App *--> CanvasView
App *--> Inspector
App *--> ReactionsPanel
App *--> Modal
App *--> Document
App *--> Runtime
ShapeTree ..> RowHover
Inspector ..> RowHover
ReactionsPanel ..> RowHover
Modal ..> RowHover
Chrome ..> UiTheme
CanvasView ..> TextUtil

Document *--> Shape
Document *--> Param
Document *--> Reaction
Reaction *--> Step
Step *--> Track
Document ..> FieldDef
Document ..> Json
Document ..> Gene
BaseDef *--> SignalDef
BaseDef *--> BaseRead
Document ..> BaseDef

Gene ..> GeneNode
Gene ..> GeneValue

' The central decision: ONE grammar, TWO consumers, and a proof that they agree.
Gene <.. CppEmitter : emit
Gene <.. Runtime : interpret
Verifier ..> CppEmitter
Verifier ..> Runtime
Verifier ..> RecordingTarget : diffs op streams

Runtime *--> Host
Host --|> VisualLoop
Host --|> ProgressIndicator
Runtime ..> Segment
Runtime ..> Property
Runtime ..> Tween

note bottom of CppEmitter
  Emits C++ that depends on artboard ALONE.
  Nothing in the generated file mentions genesis.
end note
@enduml
