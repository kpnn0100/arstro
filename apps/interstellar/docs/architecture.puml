App --> InterstellarService : dispatch(Command) / model()
Monitor --> Segment
TimelineView --> Segment
LaneStack --> Segment
InterstellarService --> Command
InterstellarService --> Event
InterstellarService --> AppModel
InterstellarService --> Project
InterstellarService --> Timeline
InterstellarService --> ParamRegistry
InterstellarService --> Evaluator
InterstellarService --> Composite
InterstellarService --> FrameCache
InterstellarService --> RackEmbed
InterstellarService --> RenderJob
InterstellarService --> Playback
InterstellarService --> ThreadBudget
AppModelCodec --> AppModel
ApiDoc --> Command
ApiDoc --> Event
ApiDoc --> AppModel
ApiDoc --> ParamRegistry
Evaluator --> AutoClip
Evaluator --> AutoLink
Evaluator --> BindingGraph
Evaluator --> ParamRegistry
