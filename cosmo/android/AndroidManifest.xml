<?xml version="1.0" encoding="utf-8"?>
<!-- cosmo Android app: a pure-native NativeActivity (no Java/DEX). The native entry is
     libcosmo.so (android.app.lib_name=cosmo). Portrait phone UI; needs GLES 3.1 (compute). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.arstro.cosmo"
          android:versionCode="1"
          android:versionName="1.0.0-beta">

    <uses-feature android:glEsVersion="0x00030001" android:required="true" />

    <!-- Read device photos for the in-app file browser (Open Project / Import Catalog).
         On the kiosk these are auto-granted; READ_EXTERNAL_STORAGE covers <=API 32,
         READ_MEDIA_IMAGES covers API 33+. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- All-files access: scoped storage (API 30+) blocks raw reads of shared folders with
         only READ_MEDIA_IMAGES; MANAGE_EXTERNAL_STORAGE gives the in-app browser raw
         filesystem access. Auto-granted by the kiosk permission manager. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:label="cosmo"
        android:hasCode="false"
        android:allowBackup="false">
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout"
            android:screenOrientation="portrait">
            <meta-data android:name="android.app.lib_name" android:value="cosmo" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
